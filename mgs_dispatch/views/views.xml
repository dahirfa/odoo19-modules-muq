<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record model="ir.ui.view" id="truck_form_view">
        <field name="name">truck.form</field>
        <field name="model">truck.dispatch</field>
        <field name="arch" type="xml">
            <form string="Trucks Form">
                <sheet>
                    <!-- <button name="create_tag" string="CREATE TAG" type="object" attrs="{'invisible': [('tag_id','!=',False)]}" class="oe_highlight"/> -->

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="eld"/>
                            <field name="make_id"/>
                            <field name="plate"/>
                            <field name="trailer_id"/>
                            <field name="type_id"/>
                            <field name="trucking_no"/>
                            <field name="country"/>
                            <field name="state"/>
                            <field name="is_working"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="vin"/>
                            <field name="driver_id" context="{'default_is_driver':True}"/>
                            <field name="ifta_id"/>
                            <field name="rpm_loaded"/>
                            <field name="rpm_empty"/>
                            <field name="rph"/>
                            <field name="Weight"/>
                            <field name="truck_owner"/>
                            <field name="partner_id" string="Sub Contractor" invisible="truck_owner != 'type2'"/>
                            <field name="vendor_pays_for_expenses" invisible="truck_owner != 'type2'"/>
                            <field name="commission" force_save="1" widget="percentage" invisible="truck_owner != 'type2'"/>
                            <!-- <field name="tag_id"/> -->
                        </group>
                    </group>
                    <group>
                    <field name="note"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="truck_tree_view">
        <field name="name">truck.list</field>
        <field name="model">truck.dispatch</field>
        <field name="arch" type="xml">
            <list string="Trucks">
                <field name="name"/>
                <field name="plate"/>
                <field name="driver_id" context="{'default_is_driver':True}"/>
                <field name="trailer_id"/>
                <field name="truck_owner"/>
                <field name="partner_id" string="Sub Contractor"/>

            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="truck_list_action">
        <field name="name">Trucks</field>
        <field name="res_model">truck.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enter the first Truck
            </p>
        </field>
    </record>










    <record model="ir.ui.view" id="trailer_form_view">
        <field name="name">trailer.form</field>
