  <record id="mgs_mass_mail_log_list" model="ir.ui.view">
    <field name="name">mgs.mass.mail.log.list</field>
    <field name="model">mgs.mass.mail.log</field>
    <field name="arch" type="xml">
      <list string="" editable="bottom">
        <!-- <field name="sms_id"/> -->
        <field name="partner_id" 
        readonly="1"
        />
        <field name="mobile" readonly="1"/>
        <field name="email" readonly="1"/>
        <field name="mail_list_id" readonly="1"/>
        <field name="description" readonly="1"/>
        <field name="state" readonly="1" widget='badge' decoration-danger="state == 'failed'" decoration-success=" state=='sent'"/>
      </list>
    </field>
  </record>


  <record id="mgs_mass_mail_log_action" model="ir.actions.act_window">
    <field name="name">Mass Mail log</field>
    <field name="res_model">mgs.mass.mail.log</field>
    <field name="view_mode">list</field>
  </record>


