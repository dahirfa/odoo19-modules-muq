    <record model="ir.actions.act_window" id="pm_utility_reading_out_action">
        <field name="name">Utility reading</field>
        <field name="res_model">pm.utility.reading</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_reading_type':'out_invoice'}</field>
        <field name="domain">[('reading_type','=','out_invoice')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first utility reading
            </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pm_utility_reading_in_action">
        <field name="name">Utility reading</field>
        <field name="res_model">pm.utility.reading</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_reading_type':'in_invoice'}</field>
        <field name="domain">[('reading_type','=','in_invoice')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first utility reading
            </p>
        </field>
    </record>

    <menuitem id="utility_menu" name="Utilities"
              parent="tis_property_managment.main_property_managment_menu" sequence="14"/>

    <menuitem id="utility_reading_menu_inv" name="Utility Invoices" parent="utility_menu" action="pm_utility_reading_out_action"/>
    <menuitem id="utility_reading_menu_bill" name="Utility Bills" parent="utility_menu" action="pm_utility_reading_in_action"/>


</odoo>