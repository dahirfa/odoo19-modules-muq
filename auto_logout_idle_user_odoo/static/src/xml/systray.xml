<?xml version="1.0" encoding="UTF-8" ?>
<!--adding new icon in the systray bar for displaying the idle time of user-->
<templates>
    <t t-name="auto_logout_idle_user_odoo.TimerSystray">
        <div class="new_icon" t-if="state.idle_time">
            <div id="div-timer" title="Time left before automatic logout">
                <i class="fa fa-clock-o systray-icon" />
                <p style="margin: unset;" t-esc="state.idle_time"/>
            </div>
        </div>
    </t>
</templates>
