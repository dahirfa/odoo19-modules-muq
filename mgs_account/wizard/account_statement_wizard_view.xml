<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_mgs_account_statement_wizard_fom" model="ir.ui.view">
        <field name="name">mgs_account_account_statement_form</field>
        <field name="model">mgs_account.account_statement</field>
        <field name="arch" type="xml">
            <form string="Invoice Report Wizard">
                <group>
                    <group>
                        <field name="date_from"/>          
                        <field name="account_id"/>
                        <field name="partner_id"/>
                        <field name="analytic_account_id"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                        <field name="report_by"/>
                        <field name="target_moves"/>
                         <field name="company_id"/>
                    </group>
                </group>
                <footer>
                    <button name="check_report" type="object" string="Generate Report" class="btn btn-primary"/>
                    <button name="export_to_excel" type="object" string="EXCEL" class="btn btn-success"/>
                    <button string="Cancel" class="btn btn-danger" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->

    <record id="action_mgs_account_statement_report" model="ir.actions.act_window">
        <field name="name">MGS Account Statement Report</field>
        <field name="res_model">mgs_account.account_statement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_mgs_account_statement_wizard_fom"/>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
 
    <menuitem id="menu_account_statement_report" name="Account Statement" parent="account.menu_finance_reports" action="action_mgs_account_statement_report" sequence="66"/>
</odoo>