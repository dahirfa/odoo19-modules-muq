<odoo>
    <record model="ir.ui.view" id="landlord_summary_wizard_form">
        <field name="name"> Landlord summary Report</field>
        <field name="model">pm.landlord.statement.wizard.report</field>
        <field name="arch" type="xml">
            <form>
            <group>                    
                <group>
                    <field name="start_date"/>
                    <field name="landlord_id"/>
                </group>               
                <group>
                    <field name="end_date"/>
                    <field name="parent_property_ids" widget="many2many_tags" domain="landlord_id and [('landlord_id', '=', landlord_id)] or []"/>
                    <!-- <field name="company_id" groups="base.group_multi_company"/> -->

                </group>
            </group>
            <footer>
                <button string="Print Landlord Summary" name="print_landlord_statement" type="object" class="btn btn-success"/>
                <button string="Cancel" special="cancel" class="btn btn-secondary"/>
            </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="landlord_summary_wizard_action">
        <field name="name">Landlord Summary Report</field>
        <field name="res_model">pm.landlord.statement.wizard.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="landlord_statement_wizard_menu"
              name="Landlord Summary"
              parent="property_managment_report_menu"
              action="landlord_summary_wizard_action"/>


</odoo>