<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="freight_receipt_print_wizard_view_form" model="ir.ui.view">
        <field name="name">freight.receipt.print.wizard.form</field>
        <field name="model">freight.receipt.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Receipt">
                <group>
                    <group>
                        <field name="receipt_id" invisible="1"/>
                        <field name="date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
