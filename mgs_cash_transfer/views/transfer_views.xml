<odoo>
  <record id="view_cash_transfer_form" model="ir.ui.view">
    <field name="name">cash.transfer.form</field>
    <field name="model">mgs_cash_transfer.transfer</field>
    <field name="arch" type="xml">
      <form string="Cash Transfer">
        <header>
          <button string="Post" type="object" name="action_post"
                class="oe_highlight" invisible="state != 'draft'"/>
          <button string="Cancel" type="object" name="action_cancel"
                 invisible="state != 'posted'"/>
          <button string="Reset to Draft" type="object" name="action_reset_to_draft"
               invisible="state != 'cancel'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="button_open_journal_entry" type="object" class="oe_stat_button" icon="fa-bars" groups="account.group_account_user,account.group_account_readonly">
              <div class="o_stat_info">
                <span class="o_stat_text">Journal Entry</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <label for="amount"/>
              <div name="amount_div" class="o_row">
                <field name="amount" readonly="state != 'draft'"/>
              </div>
              <field name="show_rate" invisible="1"/>
              <field name="currency_rate" invisible="show_rate != True" string="Currency Rate" groups="base.group_multi_currency"/>
              <label for="override_rate" string="Custom Rate" groups="base.group_multi_currency"/>
              <div name="amount_div" class="o_row" groups="base.group_multi_currency">
                <field name="override_rate" readonly="state != 'draft'" invisible="show_rate != True"/>
                <field name="custom_rate"  readonly="state != 'draft'" invisible="override_rate != True" required="override_rate == True"/>
              </div>
              <field name="date" readonly="state != 'draft'"/>
              <field name="memo"/>
              <field name="company_id" readonly="state != 'draft'" options="{'no_create': True}" groups="base.group_multi_company"/>
            </group>
            <group>
              <field name="journal_id" string="From" readonly="state != 'draft'" options="{'no_create': True}" domain="[('id', '!=', destination_journal_id), ('type', 'in', ['cash', 'bank'])]"/>
              <field name="destination_journal_id" string="To" readonly="state != 'draft'" options="{'no_create': True}" domain="[('id', '!=', journal_id), ('type', 'in', ['cash', 'bank'])]"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_cash_transfer_list" model="ir.ui.view">
    <field name="name">cash.transfer.list</field>
    <field name="model">mgs_cash_transfer.transfer</field>
    <field name="arch" type="xml">
      <list string="Cash Transfers">
        <field name="name" string="Transfer#"/>
        <field name="date"/>
        <field name="journal_id" string="From"/>
        <field name="destination_journal_id" string="To"/>
        <field name="currency_id" string="Transfer Currency" optional="hide"/>
        <field name="amount" sum="amount"/>
        <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'"/>
      </list>
    </field>
  </record>

  <record id="view_cash_transfer_search" model="ir.ui.view">
      <field name="name">cash.transfer.search</field>
      <field name="model">mgs_cash_transfer.transfer</field>
      <field name="arch" type="xml">
        <search string="Cash Transfers">
          <field name="name"/>
          <field name="journal_id"/>
          <field name="destination_journal_id"/>
          <field name="memo"/>

          <filter string="Today" name="today" domain="[('date', '=', context_today()), ('state', '=', 'posted')]"/>
          <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
          <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
          <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancel')]"/>


          <!-- Group By using filter with context -->
            <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
            <filter string="State" name="group_by_date" context="{'group_by':'date'}"/>
            <filter string="Journal" name="group_by_journal" context="{'group_by':'journal_id'}"/>
        </search>
      </field>
    </record>

  <record id="action_cash_transfer" model="ir.actions.act_window">
    <field name="name">Cash/Bank Internal Transfers</field>
    <field name="res_model">mgs_cash_transfer.transfer</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_cash_transfer_list"/>
    <field name="search_view_id" ref="view_cash_transfer_search"/>
  </record>

  <!-- <menuitem id="menu_cash_transfer_root" name="Cash Transfer" sequence="10" web_icon="mgs_cash_transfer,static/description/icon.png" groups="mgs_cash_transfer.group_mgs_cash_transfer_user"/> -->
  <menuitem id="menu_cash_transfer" name="Transfers" parent="account.menu_finance" action="action_cash_transfer" sequence="4" groups="mgs_cash_transfer.group_mgs_cash_transfer_user"/>
  <!-- <menuitem id="menu_cash_transfer_config" name="Configuration" parent="menu_cash_transfer_root" sequence="1000"/> -->
  <menuitem id="menu_cash_transfer_config_settings" name="Cash Transfer Settings" parent="account.menu_finance_configuration" action="res_config_settings_action_mct" sequence="100"/>
</odoo>