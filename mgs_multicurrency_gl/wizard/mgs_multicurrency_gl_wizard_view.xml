<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="multi_currency_general_ledger_wizard" model="ir.ui.view">
            <field name="name">General Ledger</field>
            <field name="model">mgs.multicurrency.gl.wizard</field>
            <field name="arch" type="xml">
                <form string="General Ledger">
                    <div class="alert alert-info" role="alert">
                        <p>
                            
                            Click on <strong> Print </strong> button to print general ledger report.
                        </p>

                        <small class="form-text text-muted">If an account is chosen make sure to select the correct currency.</small>

                    </div>
                    <group>
                        <field name="account_id" placeholder="Select Account" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>

                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <group>
                            <field name="date_from" placeholder="Select Start Date"/>
                            <field name="date_to" placeholder="Select End Date"/>
                            <field name="target_move" widget="radio"/>
                        </group>
                        <group>
                            <field name="currency_id" placeholder="Select Currency" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" />
                            <field name="reconciled"/>
                            <field name="summary"/>
                        </group>
                    </group>
                    <footer>
                        <button name="print_general_ledger" type="object" string="Print" class="btn btn-primary active" icon="fa-file-pdf-o" data-toggle="tooltip" title="Print General Ledger"/>
                        or
                        <button string="Cancel" class="btn btn-danger" special="cancel" icon="fa-times"/>
                    </footer>

                </form>

            </field>
        </record>


        <record id="multi_currency_general_ledger_action" model="ir.actions.act_window">
            <field name="name">General Ledger</field>
            <field name="res_model">mgs.multicurrency.gl.wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="multi_currency_general_ledger_wizard"/>
            <field name="target">new</field>
        </record>

        <menuitem name="Multi Currency General Ledger" action="multi_currency_general_ledger_action" id="multi_currency_general_ledger_id" parent="account_reports.account_reports_audit_menu" sequence="3"/>

    </data>
</odoo>