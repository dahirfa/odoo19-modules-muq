<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mgs_mailing_list_list" model="ir.ui.view">
    <field name="name">mgs_mailing_list.list</field>
    <field name="model">mgs.mailing.list</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
      </list>
    </field>
  </record>


  <record id="mgs_mailing_list_form" model="ir.ui.view">
    <field name="name">mgs.mailing.list.form</field>
    <field name="model">mgs.mailing.list</field>
    <field name="arch" type="xml">
      <form string="">
        <header>
        </header>
        <sheet>
          <h1><field name="name" placeholder="Mailing List" /></h1>
          <notebook>
              <page name="contacts" string="Contacts">
                <field name="partner_ids">
                  
                  <list editable="bottom">
                      <field name="name"/>
                      <field name="phone"/>
                      <field name="email"/>
                      
                  </list>
                  
                </field>
              </page>
          </notebook>
          
        </sheet>
      </form>
    </field>
  </record>


  <record id="mgs_mailing_list_action" model="ir.actions.act_window">
    <field name="name">Mailing List</field>
    <field name="res_model">mgs.mailing.list</field>
    <field name="view_mode">list,form</field>
  </record>


