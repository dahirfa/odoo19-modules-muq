

<odoo>
    <data>
        <record id="view_order_form_product_cost_readonly" model="ir.ui.view">
            <field name="name">Product cost</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
             
               <xpath expr="//form/sheet/notebook/page[@name='general_information']/group/group[@name='group_standard_price']/div[@name='standard_price_uom']/field[@name='standard_price']" position="replace">

                <field name="standard_price" readonly='0' groups="mgs_product_cost_readonly.group_product_cost_readonly"/>
                <field name="standard_price" invisible='0' readonly='1' groups="!mgs_product_cost_readonly.group_product_cost_readonly"/>
               
               </xpath>
                
            </field>
        </record>
          <record id="view_product_form_product_cost_readonly" model="ir.ui.view">
            <field name="name">Product cost</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
             
               <xpath expr="//form/sheet/notebook/page[@name='general_information']/group/group[@name='group_standard_price']/div[@name='standard_price_uom']/field[@name='standard_price']" position="replace">

                <field name="standard_price" readonly='0' groups="mgs_product_cost_readonly.group_product_cost_readonly"/>
                <field name="standard_price" invisible='0' readonly='1' groups="!mgs_product_cost_readonly.group_product_cost_readonly"/>
               
               </xpath>
                
            </field>
        </record>

        
    </data>
</odoo>

   