<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.rule" id="_model_late_check_in">
            <field name="name">Only company can see it.</field>
            <field name="model_id" ref="model_late_check_in"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>

       
        <record id="late_check_inform_view" model="ir.ui.view">
            <field name="name">late.check_in.form</field>
            <field name="model">late.check_in</field>
            <field name="arch" type="xml">
                <form string="Late Check-in" create="false">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="f_approve,approved,done"/>
                        <button name="approve" string="Approve"
                                type="object" class="btn-primary"
                                invisible="state != 'refused'"
                                 groups="hr.group_hr_manager"/>
                        <button name="reject" string="Wave" type="object"
                                class="btn-danger"
                                
                                invisible="state != 'approved'"
                                groups="hr.group_hr_manager"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="0"
                                       placeholder="Reference ...." invisible="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name='employee_id' options="{'no_quick_create': True, 'no_create_edit' : True}"
                                readonly="state != 'draft'"
                                 />
                                <field name='company_id' options="{'no_quick_create': True, 'no_create_edit' : True}" readonly="1"/>
                                <field name='late_minutes'/>
                            </group>
                            <group>
                                <field name='date'/>
                                <field name="amount"/>
                                <field name="attendance_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="late_check_in_view_search" model="ir.ui.view">
            <field name="name">late.check_in.search.view</field>
            <field name="model">late.check_in</field>
            <field name="arch" type="xml">
                <search string="Search Late check-in records">
                    <field name="employee_id"/>
                    <filter string="Current Month" name="current_month"
                     domain="[('date','&lt;',(context_today()+relativedelta(months=1)).strftime('%%Y-%%m-01')), ('date','&gt;=',time.strftime('%%Y-%%m-01'))]"/>
                    <filter string="Prev Month" name="prev_month" 
                    domain="[('date','&gt;=',(context_today()-relativedelta(months=1)).strftime('%%Y-%%m-01')),('date','&lt;',time.strftime('%%Y-%%m-01'))]"/>
                    <group>
                        <filter string="Employee" name="group_employee" domain="[]"
                                context="{'group_by':'employee_id'}"/>
                    </group>
                    <group>
                        <filter string="date" name="group_date" domain="[]"
                                context="{'group_by':'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- list View -->
        <record id="late_check_in_list_view" model="ir.ui.view">
            <field name="name">late.check_in.list</field>
            <field name="model">late.check_in</field>
            <field name="arch" type="xml">
                <list string="Late Check-in">

                   
                    <field name="employee_id"/>
                    <field name="late_minutes"/>
                    <field name="absent"/>
                    <field name="date"/>
                    <field name="amount"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

       
        <record id="late_check_in_action" model="ir.actions.act_window">
            <field name="name">Late Check-in</field>
            <field name="res_model">late.check_in</field>
            <field name="view_mode">list,form</field>
            <field name="context">{
            'search_default_group_employee': 1,
            }
        </field>
        </record>


        <record id="mgs_attendance_checker_wizard_form" model="ir.ui.view">
            <field name="name">mgs.attendance.checker.wizard.form</field>
            <field name="model">mgs.attendance.checker.wizard</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group >
                            <field name="date_from"/>
                        </group>
                        <group >
                            <field name="date_to"/>
                        </group>
                        <notebook>
                            <page name="employee" string="Employees">
                                <field name="employee_ids">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <footer>
                            <button name="check_attendance"  string="Confirm" type="object" class="oe_highlight"/>
                            <button string="Cancel" special="cancel"/>
                          </footer>
                    </sheet>
                </form>
            </field>
        </record>

            <record id="mgs_attendance_checker_wizard_action" model="ir.actions.act_window">
                <field name="name">mgs.attendance.checker.wizard.action</field>
                <field name="res_model">mgs.attendance.checker.wizard</field>
                <field name="view_mode">form</field>
                <field name="target">new</field>
            </record>


        <menuitem id="mgs_late_absence" name="Late Check-in/Absence"
            parent="hr_attendance.menu_hr_attendance_root"
            sequence="21"
            groups="hr.group_hr_user"/>

        <menuitem id="menu_late_check_in_wiz" name="Check-in/Absence Wiz"
                parent="mgs_late_absence"
                action="mgs_attendance_checker_wizard_action"
                sequence="1"
                />

        <menuitem id="menu_late_check_in" name="Late Check-in"
                  parent="mgs_late_absence"
                  action="late_check_in_action"
                  sequence="21"/>



    </data>
</odoo>
