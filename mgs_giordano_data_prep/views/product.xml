<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_template_barcode_notes_view" model="ir.ui.view">
        <field name="name">product.template.barcode.notes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="barcode_before_converted_to_gtin14"/>                    
            </xpath>
        </field>
    </record>



    <!-- Barcodes Update Server Action -->
    <record id="action_fix_barcode_length" model="ir.actions.server">
        <field name="name">Fix Barcode Padding</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records._fix_barcode_length()</field>
    </record>


</odoo>
