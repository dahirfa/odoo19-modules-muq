<odoo>
    <data>
        <!-- Inherit the account payment form view -->
        <record id="view_payment_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <!-- Add the new fields after partner_id -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="mgs_partner_balance" invisible="partner_id == False" style="background-color:#03fefa;border:15px;border-radius:10px;width:40%;padding-left:10px;"/>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="mgs_journal_balance" invisible="journal_id == False" style="background-color:#03fefa;border:15px;border-radius:10px;width:40%;padding-left:10px;"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
