<odoo>
    <record model="ir.ui.view" id="landlord_account_statment_wizard_form">
        <field name="name"> Landlord Statement Report</field>
        <field name="model">pm.landlord.account.statement.wizard</field>
        <field name="arch" type="xml">
            <form>
            <group>
                    
                <group>
                    <field name="start_date"/>
                    <field name="landlord_id"/>
                </group>               
                <group>
                    <field name="end_date"/>
                    <!-- <field name="company_id" groups="base.group_multi_company"/> -->
                </group>
            </group>
            <footer>
                <button string="Print Landlord Statement" name="print_landlord_account_statement" type="object" class="btn btn-success"/>
                <button string="Cancel" special="cancel" class="btn btn-secondary"/>
            </footer>
            </form>

        </field>
    </record>

    <record model="ir.actions.act_window" id="landlord_account_statement_wizard_action">
        <field name="name">Landlord Statement Report</field>
        <field name="res_model">pm.landlord.account.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="landlord_account_statement_wizard_menu"
              name="Landlord Statement"
              parent="property_managment_report_menu"
              action="landlord_account_statement_wizard_action"/>


</odoo>