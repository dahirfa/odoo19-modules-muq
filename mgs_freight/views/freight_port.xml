<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="freight_port_form" model="ir.ui.view">
        <field name="name">freight.port.form</field>
        <field name="model">freight.port</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group >
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_port_tree" model="ir.ui.view">
        <field name="name">freight.port.tree</field>
        <field name="model">freight.port</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="freight_port_action" model="ir.actions.act_window">
        <field name="name">Freight Port</field>
        <field name="res_model">freight.port</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new Freight port
            </p>
        </field>
    </record>


    <!-- Product Template Form -->
    <record id="inherit_product_template_form" model="ir.ui.view">
        <field name="name">inherit_product_template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="measurement_type"/>
            </xpath>
        </field>
    </record>

    <record  id="products_list_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="context">{'defaul_type':'service'}</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enter the first product
            </p>
        </field>
    </record>

    <menuitem
        id="freight_menu"
        name="Freight"
        sequence="1"
        web_icon="mgs_freight,static/description/icon.png"
        groups="mgs_freight.group_freight_user"
        />
    <menuitem
        id="config_menu"
        name="Configuration"
        parent="freight_menu"
        sequence="50"/>
    <menuitem
        id="freight_port_menu"
        name="Ports"
        action="freight_port_action"
        parent="config_menu"
        sequence="1"/>
    <menuitem
        id="product_list_menu"
        name="Products"
        action="products_list_action"
        parent="config_menu"
        sequence="2"/>
</odoo>