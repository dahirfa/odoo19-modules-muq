<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_receipt_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div class="page">
                <div class="row mb8">
                    <div class="col-12" t-if="o.partner_type" style="font-weight: bold; font-size: 22px; text-align: center; background-color: #a7adba; border: 1px solid #EAECEE;">
                        <strong t-if="o.payment_type == 'inbound'">RECEIPT VOUCHER</strong>
                        <strong t-elif="o.payment_type == 'outbound'">PAYMENT VOUCHER</strong>
                    </div>
                </div>
                <br/>
                <div class="row justify-content-end mb16">
                    <div class="col-4" name="right_box">
                        <div t-if="o.name and o.name != '/'" t-field="o.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;'}"/>
                    </div>
                </div>

                <br/>

                <div class="row mb8" style="font-size:16px; font-weight:bold;">
                    <div class="col-3" t-if="o.amount">
                        <strong t-if="o.payment_type == 'inbound'">Amount:</strong>
                        <strong t-elif="o.payment_type == 'outbound'">Paid Amount:</strong>
                    </div>
                    <div class="col-4" t-if="o.amount" style="background-color:#EAECEE;border:1px solid #ABB2B9;padding-left: 10px;">
                        <strong><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                    </div>
                    <div class="col-2 text-end" style="border:1px solid #ABB2B9;padding-left: 20px;">
                        <strong>Date:</strong>
                    </div>
                    <div class="col-3" t-if="o.date" style="border:1px solid #ABB2B9;padding-left: 10px;">
                        <span t-field="o.date"/>
                    </div>
                </div>

                <div class="row mb8" style="font-size:16px; font-weight:bold;">
                    <div class="col-3" t-if="o.partner_type">
                        <strong t-if="o.partner_type == 'customer'">Customer: </strong>
                        <strong t-elif="o.partner_type == 'supplier'">Vendor: </strong>
                    </div>
                    <div class="col-9" t-if="o.partner_type" style="border:1px solid #ABB2B9;padding-left: 10px;">
                        <span t-field="o.partner_id"/>
                    </div>
                </div>

                <div class="row mb8" style="font-size:16px; font-weight:bold;">
                    <div class="col-3">
                        <strong>Voucher No:</strong>
                    </div>
                    <div class="col-9" style="border:1px solid #ABB2B9;padding-left: 10px;">
                        <span t-field="o.name"/>
                    </div>
                </div>

                <div class="row mb8" style="font-size:16px; font-weight:bold;" t-if="o.memo">
                    <div class="col-3">
                        <strong>Remarks:</strong>
                    </div>
                    <div class="col-9" style="border:1px solid #ABB2B9;padding-left: 10px;">
                        <span t-field="o.memo"/>
                    </div>
                </div>

                <div class="row mb8" style="font-size:16px; font-weight:bold;">
                    <div class="col-3">
                        <strong>Journal Acc:</strong>
                    </div>
                    <div class="col-9" t-if="o.journal_id" style="border:1px solid #ABB2B9;padding-left: 10px;">
                        <span t-field="o.journal_id"/>
                    </div>
                </div>
                <br/>
                <br/>
                <br/>

                <div class="row" name="signatures">
                    <div class="col-7">
                        <strong>Partner:</strong>________________________
                    </div>
                    <div class="col-5 text-end">
                        <strong>Cashier:</strong>________________________
                    </div>
                </div>

                <br/>
                <br/>
            </div>
        </t>
    </template>

    <!-- High priority so this runs after any other extension targeting the same node. -->
    <template id="report_payment_receipt" inherit_id="account.report_payment_receipt" priority="99">
        <xpath expr="//t[@t-call='account.report_payment_receipt_document']" position="attributes">
            <attribute name="t-call">mgs_document_designs.report_payment_receipt_document</attribute>
        </xpath>
    </template>
</odoo>
