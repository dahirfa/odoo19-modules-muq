<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Create the group -->
        <record id="journal_restrict_group" model="res.groups">
            <field name="name">Journal Restriction Group</field>
        </record>

        <!-- Restrict Journal Visibility -->
        <record id="account_journal_restrict_rule" model="ir.rule">
            <field name="name">Allowed Journals Only</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="groups" eval="[(4, ref('mgs_account_journal_restrict.journal_restrict_group'))]"/>
            <field name="domain_force">[('id', 'in', user.journal_ids.ids)]</field>
        </record>

    </data>
</odoo>
