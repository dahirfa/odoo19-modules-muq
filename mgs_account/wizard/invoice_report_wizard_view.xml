<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_mgs_invoice_report_wizard_form" model="ir.ui.view">
        <field name="name">mgs.invoice.report.wizard.form</field>
        <field name="model">mgs_account.invoice_report</field>
        <field name="arch" type="xml">
            <form string="Invoice Report Wizard">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="invoice_or_bill" invisible="1"/>
                        <field name="user_id"/>
                        <field name="team_id"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                        <field name="categ_id"/>
                        <field name="parent_categ_id"/>
                    </group>
                    <group>
                        <field name="report_type"/>
                        <field name="group_by" invisible="1"/>
                        <field name="company_id"/>
                    </group>
                </group>
                <footer>
                    <button name="check_report" type="object" string="Generate Report" class="btn btn-primary"/>
                    <button name="export_to_excel" type="object" string="EXCEL" class="btn btn-success"/>
                    <button string="Cancel" class="btn btn-danger" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_mgs_invoice_report_by_partner" model="ir.actions.act_window">
        <field name="name">MGS Invoice Report BY PARTNER</field>
        <field name="res_model">mgs_account.invoice_report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_mgs_invoice_report_wizard_form"/>
        <field name="context">{'default_group_by': 'partner', 'default_invoice_or_bill': 'invoice'}</field>
        <field name="target">new</field>
    </record>

    <record id="action_mgs_invoice_report_by_item" model="ir.actions.act_window">
        <field name="name">MGS Invoice Report BY ITEM</field>
        <field name="res_model">mgs_account.invoice_report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_mgs_invoice_report_wizard_form"/>
        <field name="context">{'default_group_by': 'item', 'default_invoice_or_bill': 'invoice'}</field>
        <field name="target">new</field>
    </record>

    <record id="action_mgs_bill_report_by_partner" model="ir.actions.act_window">
        <field name="name">MGS Bill Report BY PARTNER</field>
        <field name="res_model">mgs_account.invoice_report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_mgs_invoice_report_wizard_form"/>
        <field name="context">{'default_group_by': 'partner', 'default_invoice_or_bill': 'bill'}</field>
        <field name="target">new</field>
    </record>

    <record id="action_mgs_bill_report_by_item" model="ir.actions.act_window">
        <field name="name">MGS Bill Report BY ITEM</field>
        <field name="res_model">mgs_account.invoice_report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_mgs_invoice_report_wizard_form"/>
        <field name="context">{'default_group_by': 'item', 'default_invoice_or_bill': 'bill'}</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_mgs_invoice_report" name="MGS-Invoice Reports" parent="account.menu_finance_reports" sequence="42"/>
    
    <menuitem id="menu_invoice_by_partner_report" name="Invoices by Partner" parent="menu_mgs_invoice_report" action="action_mgs_invoice_report_by_partner" sequence="1"/>
    <menuitem id="menu_invoice_by_item_report" name="Invoices by Item" parent="menu_mgs_invoice_report" action="action_mgs_invoice_report_by_item" sequence="2"/>
    
    <menuitem id="menu_bill_by_partner_report" name="Bills by Partner" parent="menu_mgs_invoice_report" action="action_mgs_bill_report_by_partner" sequence="3"/>
    <menuitem id="menu_bill_by_item_report" name="Bills by Item" parent="menu_mgs_invoice_report" action="action_mgs_bill_report_by_item" sequence="4"/>
</odoo>