                          <field name="state"/>
                          <field name="is_third_party_trailer"/>
                        </group>
                        <group>
                          <field name="type_id"/>
                          <field name="trucking_no"/>
                          <field name="vin"/>
                          <field name="Weight"/>
                          <field name="equipment"/>
                          <field name="is_working"/>
                          <field name="company_id" readonly="1" groups="base.group_multi_company"/>

                        </group>
                    </group>
                    <group>
                    <field name="note"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

