<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_order_form" model="ir.ui.view">
    <field name="name">sale.order.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <xpath
          expr="//page[@name='order_lines']//field[@name='order_line']//list//field[@name='price_subtotal']"
          position="after"
            >
        <field name="warehouse_id" options="{'no_create': True, 'no_open': True}" />
      </xpath>
    </field>
  </record>
  <record id="view_order_form_form" model="ir.ui.view">
    <field name="name">sale.order.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']//form//group" position="inside">
        <field name="warehouse_id" options="{'no_create': True, 'no_open': True}" />
      </xpath>
      <xpath expr="//field[@name='order_line']" position="attributes">
        <attribute name="context" >{'default_warehouse_id': warehouse_id}</attribute>
      </xpath>
    </field>
  </record>
</odoo>
