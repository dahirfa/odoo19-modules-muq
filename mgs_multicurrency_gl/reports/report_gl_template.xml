<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="gl_report_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <style>
                        th,td {
                            padding: 0.30rem;
                            border-top: 1px solid #212529;
                            border-bottom: 1px solid #212529;
                        }
                    </style>
                    <t t-if="not summary">
                        <t t-foreach="accounts" t-as="account">
                            <div style="page-break-after: always;">
                                <div style="background-color: #008B8B; color:#fff !important; font:20px lucida-console,sans-serif !important;font-weight: bold;">
                                    <strong>
                                        <div style="border: 1px solid black;">
                                            <center> Account Statement </center>
                                        </div>
                                    </strong>
                                </div>

                                <div class="row mt32 mb32" style='font-size:12px'>
                                    <div class="col-auto">
                                        <strong>Target Moves: </strong>
                                        <t t-if="target_move == 'all'">All Entries</t>
                                        <t t-if="target_move == 'posted'">All Posted Entries</t>
                                    </div>

                                    <t t-if="data['account_id'][0]">
                                        <div class="col-auto">
                                            <strong>Account: </strong>
                                            <span t-esc="data['account_id'][1]" />
                                        </div>
                                    </t>
                                    <t t-if="data['display_currency']">
                                        <div class="col-auto">
                                            <strong>Currency: </strong>
                                            <span t-esc="data['display_currency']" />
                                        </div>
                                    </t>
                                </div>

                                <div class="row mt32 mb32" style='font-size:12px'>
                                    <t t-if="data['date_from']">
                                        <div class="col-auto">
                                            <strong>Start Date: </strong>
                                            <span t-esc="data['date_from']" />
                                        </div>
                                    </t>
                                    <t t-if="data['date_to']">
                                        <div class="col-auto">
                                            <strong>End Date: </strong>
                                            <span t-esc="data['date_to']" />
                                        </div>
                                    </t>

                                    <div class="col-auto">
                                        <strong>Report Type: </strong>
                                        <span>Detailed</span>
                                    </div>
                                </div>



                                <table class="table table-condensed table-sm" style='font-size:12px'>
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th></th>
                                            <th>Ref</th>
                                            <th>Description</th>
                                            <!-- <th>Cheque Reference</th> -->
                                            <th style="text-align:right;">Debit</th>
                                            <th style="text-align:right;">Credit</th>
                                            <t t-if="reconciled == True">
                                                <th style="text-align:right;">Balance</th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="8">
                                                <strong t-esc="account.name" style='font-size:14px' />
                                            </td>

                                        </tr>

                                        <tr>
                                            <td colspan="8" style='background-color:#F0ECE5;'>
                                                <strong t-esc="currency[1]" />
                                            </td>
                                        </tr>

                                        <t t-if="previous_balance(account.id, date_from, currency[0])">
                                            <tr style="font-style:italic; font-size:12px; ">

                                                <t t-if="reconciled">
                                                    <td colspan='6' style='font-weight:bold; text-align:right;color:red;'>
                                                            Previous Balance
                                                    </td>
                                                </t>


                                                <t t-if="not reconciled">
                                                    <td colspan='6' style='font-weight:bold; text-align:right;color:red;'>
                                                            Previous Balance
                                                    </td>
                                                </t>


                                                <td style='font-weight:bold; text-align:right;color:red;'>


                                                    <t t-esc="display_currency"/>
                                                    <t t-esc="'{:,.2f}'.format(previous_balance(account.id, date_from, currency[0]).get('previous_balance')) or 0.0" />
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-set="accounted_balance" t-value="0.0 + previous_balance(account.id, date_from, currency[0]).get('previous_balance') or 0.0" />


                                        <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">

                                            <t t-foreach="lines(date_to, date_from, move_state, account.id, currency[0])" t-as="line">
                                                <t t-if="line['debit'] > 0 or line['credit'] > 0">
                                                    <tr>

                                                        <t t-set="accounted_balance" t-value="accounted_balance + line['balance']" />

                                                        <td colspan='2' style='white-space: nowrap;'>
                                                            <span t-esc="line['date']" />
                                                        </td>

                                                        <td>
                                                            <span t-esc="line['displayed_name']" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="line['description']" />
                                                        </td>


                                                        <td style="text-align:right;">

                                                            <span t-esc="'{:,.2f}'.format(line['debit']) or 0.00" />
                                                        </td>
                                                        <td style="text-align:right;">

                                                            <span t-esc="'{:,.2f}'.format(line['credit']) or 0.00" />
                                                        </td>
                                                        <t t-if="reconciled == True">
                                                            <td style="text-align:right;">

                                                                <span t-esc="'{:,.2f}'.format(accounted_balance) or 0.00" />


                                                            </td>
                                                        </t>
                                                    </tr>

                                                </t>

                                            </t>

                                            <tr>
                                                <td colspan='4' style='font-weight:bold;font-size:18px'>
                                                        TOTAL
                                                </td>
                                                <td style="text-align:right;">
                                                    <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">
                                                        <strong>
                                                            <t t-esc="display_currency"/>
                                                            <span t-esc="'{:,.2f}'.format(lines(date_to, date_from, move_state, account.id, currency[0])[0].get('debit_total'))" />
                                                        </strong>
                                                    </t>
                                                </td>

                                                <td style="text-align:right;">
                                                    <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">
                                                        <strong>
                                                            <t t-esc="display_currency"/>
                                                            <span t-esc="'{:,.2f}'.format(lines(date_to, date_from, move_state, account.id, currency[0])[0].get('credit_total'))" />
                                                        </strong>
                                                    </t>
                                                </td>

                                                <td style="text-align:right;">
                                                    <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">
                                                        <strong>
                                                            <t t-esc="display_currency"/>
                                                            <span t-esc="'{:,.2f}'.format(accounted_balance) or 0.00" />
                                                        </strong>
                                                    </t>
                                                </td>
                                            </tr>

                                        </t>



                                    </tbody>
                                </table>



                            </div>
                        </t>


                    </t>



                    <t t-else="">
                        <div style="background-color: #008B8B; color:#fff !important; font:20px lucida-console,sans-serif !important;font-weight: bold;">
                            <strong>
                                <div style="border: 1px solid black;">
                                    <center> General Ledger </center>
                                </div>
                            </strong>
                        </div>


                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Target Moves: </strong>
                                <t t-if="target_move == 'all'">All Entries</t>
                                <t t-if="target_move == 'posted'">All Posted Entries</t>
                            </div>

                            <t t-if="data['account_id'][0]">
                                <div class="col-6">
                                    <strong>Account: </strong>
                                    <span t-esc="data['account_id'][1]" />
                                </div>
                            </t>
                            <t t-if="data['display_currency']">
                                <div class="col-6">
                                    <strong>Currency: </strong>
                                    <span t-esc="data['display_currency']" />
                                </div>
                            </t>

                            <t t-if="data['date_from']">
                                <div class="col-6">
                                    <strong>Start Date: </strong>
                                    <span t-esc="data['date_from']" />
                                </div>
                            </t>
                            <t t-if="data['date_to']">
                                <div class="col-6">
                                    <strong>End Date: </strong>
                                    <span t-esc="data['date_to']" />
                                </div>
                            </t>

                            <div class="col-6">
                                <strong>Report Type: </strong>
                                <span>Detailed</span>
                            </div>
                        </div>




                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Partner</th>
                                    <th style="text-align:right;">Previous Balance</th>
                                    <th style="text-align:right;">Debit</th>
                                    <th style="text-align:right;">Credit</th>
                                    <t t-if="reconciled == True">
                                        <th style="text-align:right;">Balance</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="accounts" t-as="account">
                                    <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">
                                        <tr>
                                            <td></td>
                                            <td>
                                                <strong t-esc="account.name" />
                                            </td>
                                            <td style='font-weight:bold; text-align:right;color:red;'>


                                                <t t-esc="display_currency"/>
                                                <t t-esc="'{:,.2f}'.format(previous_balance(account.id, date_from, currency[0]).get('previous_balance'))" />
                                            </td>


                                            <td style="text-align:right;">
                                                <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">
                                                    <strong>
                                                        <t t-esc="display_currency"/>
                                                        <span t-esc="'{:,.2f}'.format(lines(date_to, date_from, move_state, account.id, currency[0])[0].get('debit_total'))" />
                                                    </strong>
                                                </t>


                                            </td>

                                            <td style="text-align:right;">
                                                <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">
                                                    <strong>
                                                        <t t-esc="display_currency"/>
                                                        <span t-esc="'{:,.2f}'.format(lines(date_to, date_from, move_state, account.id, currency[0])[0].get('credit_total'))" />
                                                    </strong>
                                                </t>


                                            </td>


                                            <t t-if="reconciled == True">
                                                <t t-set="accounted_balance" t-value="lines(date_to, date_from, move_state, account.id, currency[0])[0].get('balance_total') + previous_balance(account.id, date_from, currency[0]).get('previous_balance')" />

                                                <td style="text-align:right;">
                                                    <t t-if="lines(date_to, date_from, move_state, account.id, currency[0])">
                                                        <strong>
                                                            <t t-esc="display_currency"/>
                                                            <span t-esc="'{:,.2f}'.format(accounted_balance) or 0.00" />
                                                        </strong>
                                                    </t>

                                                </td>
                                            </t>


                                        </tr>


                                    </t>
                                </t>


                            </tbody>
                        </table>
                    </t>






                </div>
            </t>
        </t>
    </template>




