<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="account_journal_dashboard_inherit" model="ir.ui.view">
        <field name="name">account.journal.view.form.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='dashboard_bank_cash_right']" position="inside">
                <div class="row">
                    <div id="dashboard_bank_cash_mgs_balance" class="col text-end">
                        <a type="object" name="open_bank_difference_action" style="color:#922b21">Balance</a>
                    </div>
                    <div class="col-auto text-end" style="color:#922b21">
                        <span>
                            <t t-out="dashboard.acc_balance"/>
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>