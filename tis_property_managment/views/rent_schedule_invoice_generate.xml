<odoo>
    <record model="ir.ui.view" id="rent_schedule_generate_invoice_form">
        <field name="name">Generate Invoices Rent</field>
        <field name="model">pm.rent.schedule.generate.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
            <group>
                <group>
                    <field name="start_date"/>
                </group>
                <group>
                    <field name="end_date"/>
                    <!-- <field name="company_id" groups="base.group_multi_company"/> -->
                </group>
            </group>
            <footer>
                <button string="Generate Invoices" confirm="Are You Sure?" name="create_entries_" type="object" class="btn btn-danger"/>
                <button string="Cancel" special="cancel" class="btn btn-secondary"/>
            </footer>
            </form>

        </field>
    </record>

    <record model="ir.actions.act_window" id="rent_schedule_generate_invoice_action">
        <field name="name">Generate Invoices Rent</field>
        <field name="res_model">pm.rent.schedule.generate.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="rent_schedule_generate_invoice_menu"
              name="Generate Rent Invoices"
              parent="property_managment_report_menu"
              action="rent_schedule_generate_invoice_action"/>


</odoo>