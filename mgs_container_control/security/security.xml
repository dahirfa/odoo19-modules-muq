<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_container_control" model="res.groups.privilege">
        <field name="name">Container Control</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_container_control_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="mgs_container_control.res_groups_privilege_container_control"/>
        <field name="comment">Manage container control records and delivery orders.</field>
    </record>

    <record id="group_container_control_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="mgs_container_control.res_groups_privilege_container_control"/>
        <field name="implied_ids" eval="[(4, ref('mgs_container_control.group_container_control_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Configure demurrage rates, bill demurrage and delete records.</field>
    </record>

    <!-- Multi-company rules -->
    <record id="container_control_rule_company" model="ir.rule">
        <field name="name">Container Control: multi-company</field>
        <field name="model_id" ref="mgs_container_control.model_container_control"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="container_delivery_order_rule_company" model="ir.rule">
        <field name="name">Delivery Order: multi-company</field>
        <field name="model_id" ref="mgs_container_control.model_container_delivery_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="container_size_type_rule_company" model="ir.rule">
        <field name="name">Container Size/Type: multi-company</field>
        <field name="model_id" ref="mgs_container_control.model_container_size_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
