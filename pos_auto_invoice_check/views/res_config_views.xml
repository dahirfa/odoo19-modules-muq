<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.point_of_sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='iface_tipproduct']" position="after">
                <setting string="Auto Check Invoice on Payment ?" help="Invoice checkbox will be automatically checked in payment screen.">
                    <field name="pos_auto_invoice_on_payment" />
                </setting>
             
            </xpath>
        </field>
    </record>
</odoo>