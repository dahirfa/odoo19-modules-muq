<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sa_attendance_employee_code_list" model="ir.ui.view">
        <field name="name">view.sa.attendance.employee.code.list</field>
        <field name="model">sa.attendance.employee.code</field>
        <field name="arch" type="xml">
            <list editable='top'>
                <field name="employee_id"/>
                <field name="code"/>
                <field name="device_id"/>
            </list>
        </field>
    </record>

    <record id="view_sa_attendance_employee_code_search" model="ir.ui.view">
        <field name="name">view.sa.attendance.employee.code.search</field>
        <field name="model">sa.attendance.employee.code</field>
        <field name="arch" type="xml">
            <search>
                <group>
                    <filter string="Device" name="device_id" domain="[]" context="{'group_by':'device_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sa_attendance_employee_code" model="ir.actions.act_window">
        <field name="name">Sa Attendance Employee Code</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sa.attendance.employee.code</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Add new Sa Attendance Employee Code.
            </p>
        </field>
    </record>

</odoo>
