<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- <data> -->
    <record id="dispatch_settings_view" model="ir.ui.view">
        <field name="name">Dispatch Configuration</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">

                <app string="Mgs Dispatch"
                     name="mgs_dispatch"
                     data-string="mgs_dispatch"
                     logo="mgs_dispatch/static/description/icon.png">
                     
                    <block title="Dispatching Settings">
            
                        <setting string="Transportation Service">
                            <field name="transport_product_id"
                                   options="{'no_create': True}"/>
                        </setting>
            
                        <setting string="Commission Service">
                            <field name="commision_product_id"
                                   options="{'no_create': True}"/>
                        </setting>
            
                        <setting string="Expensing Type">
                            <field name="transport_expenseing_type"
                                   options="{'no_create': True}"/>
                        </setting>
            
                        <setting string="Analytic Plan">
                            <field name="transport_analytic_plan_id"
                                   options="{'no_create': True}"/>
                        </setting>
            
                    </block>
            
                </app>
            
            </xpath>
        </field>
    </record>

</odoo>
