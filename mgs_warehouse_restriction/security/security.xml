<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_mgs_warehouse_restriction">
            <field name="name">Warehouse</field>
            <field name="description">Helps you make your warehouses restricted.</field>
            <field name="sequence">7</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_mgs_warehouse_restriction">
            <field name="name">Warehouse</field>
            <field name="category_id" ref="module_category_mgs_warehouse_restriction"/>
            <field name="sequence">7</field>
        </record>

        <record id="warehouse_restrict_group" model="res.groups">
            <field name="name">Warehouse Restrictions</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_mgs_warehouse_restriction"/>
        </record>

        <record model="ir.rule" id="warehouse_security_rule">
            <field name="name">Warehouses restricted to users</field>
            <field name="model_id" ref="stock.model_stock_warehouse"/>
            <field name="groups" eval="[(4, ref('mgs_warehouse_restriction.warehouse_restrict_group'))]"/>
            <field name="domain_force">[('id', 'in', user.warehouse_ids.ids)]</field>
        </record>

        <record model="ir.rule" id="warehouse_security_rule_stock_picking">
            <field name="name">Stock Picking of Warehouses restricted to user</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('mgs_warehouse_restriction.warehouse_restrict_group'))]"/>
            <field name="domain_force">[('picking_type_id.warehouse_id.id', 'in', user.warehouse_ids.ids)]</field>
        </record>

        <record model="ir.rule" id="warehouse_security_rule_stock_move">
            <field name="name">Stock Move of Warehouses restricted to user</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="groups" eval="[(4, ref('mgs_warehouse_restriction.warehouse_restrict_group'))]"/>
            <field name="domain_force">['|',('picking_type_id','=',False),('picking_type_id.warehouse_id.id', 'in', user.warehouse_ids.ids)]</field>
        </record>

        <record model="ir.rule" id="warehouse_security_rule_stock_quant">
            <field name="name">Stock Quant of Warehouses restricted to user</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="groups" eval="[(4, ref('mgs_warehouse_restriction.warehouse_restrict_group'))]"/>
            <field name="domain_force">['|',('location_id.warehouse_id','=',False),('location_id.warehouse_id.id', 'in', user.warehouse_ids.ids)]</field>
        </record>

        <record model="ir.rule" id="warehouse_security_rule_stock_location">
            <field name="name">Stock Locations of Warehouses restricted to user</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="groups" eval="[(4, ref('mgs_warehouse_restriction.warehouse_restrict_group'))]"/>
            <field name="domain_force">['|',('warehouse_id','=',False),('warehouse_id.id', 'in', user.warehouse_ids.ids)]</field>
        </record>

        <record model="ir.rule" id="warehouse_security_rule_picking_type">
            <field name="name">Operation Types of Warehouses restricted to user</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field name="groups" eval="[(4, ref('mgs_warehouse_restriction.warehouse_restrict_group'))]"/>
            <field name="domain_force">['|',('warehouse_id','=',False),('warehouse_id.id', 'in', user.warehouse_ids.ids)]</field>
        </record>

    </data>
</odoo>