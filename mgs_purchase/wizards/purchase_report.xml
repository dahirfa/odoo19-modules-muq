<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_mgs_purchase_report_wizard_form" model="ir.ui.view">
        <field name="name">mgs.purchase.report.wizard.form</field>
        <field name="model">mgs_purchase.report_wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Report Wizard">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="user_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                        <field name="categ_id"/>
                        <field name="parent_categ_id"/>
                    </group>
                    <group>
                        <field name="report_type" widget="radio" class="o_horizontal_radio"/>
                        <field name="group_by" invisible="1"/>
                        <field name="currency_id"/>
                    </group>
                </group>
                <footer>
                    <button name="check_report" type="object" string="Generate Report" class="btn-primary"/>
                    <button name="export_to_excel" type="object" string="EXCEL" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mgs_purchase_report_by_product" model="ir.actions.act_window">
        <field name="name">MGS Purchase Report BY PRODUCT</field>
        <field name="res_model">mgs_purchase.report_wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_mgs_purchase_report_wizard_form"/>
        <field name="context">{'default_group_by': 'item'}</field>
        <field name="target">new</field>
    </record>

    <record id="action_mgs_purchase_report_by_vendor" model="ir.actions.act_window">
        <field name="name">MGS Purchase Report BY VENDOR</field>
        <field name="res_model">mgs_purchase.report_wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_mgs_purchase_report_wizard_form"/>
        <field name="context">{'default_group_by': 'vendor'}</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mgs_purchase_report" name="MGS-Purchase Reports" parent="purchase.purchase_report_main" sequence="999"/>
    <menuitem id="menu_purchase_by_vendor_report" name="By Vendor" parent="menu_mgs_purchase_report" action="action_mgs_purchase_report_by_vendor" sequence="1" />
    <menuitem id="menu_purchase_by_item_report" name="By Item" parent="menu_mgs_purchase_report" action="action_mgs_purchase_report_by_product" sequence="2" />
</odoo>