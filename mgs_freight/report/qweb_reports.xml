<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="freight_delivery_report" model="ir.actions.report">
        <field name="name">Delivery Report</field>
        <field name="model">freight.delivery.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_freight.delivery_report_template</field>
        <field name="report_file">mgs_freight.delivery_report_template</field>
        <field name="binding_model_id" ref="model_freight_delivery_wizard" />
        <field name="print_report_name">'%s' % object.name</field>
        <field name="binding_type">report</field>
    </record>


    <record id="freight_receipt_report" model="ir.actions.report">
        <field name="name">Receipt report </field>
        <field name="model">freight.receipt.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_freight.receipt_report_template</field>
        <field name="report_file">mgs_freight.receipt_report_template</field>
        <field name="binding_model_id" ref="model_freight_receipt_wizard" />
        <field name="print_report_name">'Receipt Report'</field>
        <field name="binding_type">report</field>
    </record>

</odoo>