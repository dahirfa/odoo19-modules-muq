<odoo>
    <record model="ir.sequence" id="seq_load">
        <field name="name">Dispatch Load</field>
        <field name="code">load.dispatch</field>
        <field name="prefix">L/%(year)s%(month)s/</field>
        <field name="padding">4</field>
    </record>

    <record model="ir.sequence" id="seq_load_line">
        <field name="name">Dispatch Trip</field>
        <field name="code">load.dispatch.line</field>
        <field name="prefix">TR/</field>
        <field name="padding">5</field>
    </record>
</odoo>