<odoo>
    <data noupdate="0">
        <!-- Custom Category -->
        <record id="module_category_mgs_cash_transfer" model="ir.module.category">
            <field name="name">Cash Transfer</field>
            <field name="description">Manage internal cash transfers</field>
            <field name="sequence">10</field>
        </record>

        <!-- Privilege (New in Odoo 19) -->
        <record id="res_groups_privilege_mgs_cash_transfer" model="res.groups.privilege">
            <field name="name">Cash Transfer</field>
            <field name="category_id" ref="module_category_mgs_cash_transfer"/>
        </record>

        <!-- User Role -->
        <record id="group_mgs_cash_transfer_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_mgs_cash_transfer"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Admin Role -->
        <record id="group_mgs_cash_transfer_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_mgs_cash_transfer"/>
            <field name="implied_ids" eval="[(4, ref('group_mgs_cash_transfer_user'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <!-- <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('module_category_mgs_cash_transfer'))]"/>
        </record> -->
        <!-- Record Rules -->
        <record id="cash_transfer_user_rule" model="ir.rule">
            <field name="name">Cash Transfer Multi-company Rule</field>
            <field name="model_id" ref="model_mgs_cash_transfer_transfer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>