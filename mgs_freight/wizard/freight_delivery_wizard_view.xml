<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="freight_delivery_wizard" model="ir.ui.view">
            <field name="name">freight delivery wizard</field>
            <field name="model">freight.delivery.wizard</field>
            <field name="arch" type="xml">
                <form string="">
                    <group >
                        <field name="customer_id"/>
                        <field name="delivery_id"/>
                        <field name="summary"/>
                        <field name="add_customer"/>
                        <field name="status_type" widget="radio"/>
                    </group>
                    <footer>
                        <button name="print_report" type="object" string="Print" class="btn btn-primary active" icon="fa-file-pdf-o" data-toggle="tooltip" />
                        or
                        <button string="Cancel" class="btn btn-danger" special="cancel" icon="fa-times"/>
                    </footer>

                </form>
            
            </field>
        </record>

        
        <record id="freight_delivery_wizard_action" model="ir.actions.act_window">
            <field name="name">Delivery Report</field>
            <field name="res_model">freight.delivery.wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="freight_delivery_wizard"/>
            <field name="target">new</field>
        </record>

        <menuitem
            id="reports_menu"
            name="Reports"
            parent="freight_menu"
            sequence="10"/>
        <menuitem
            id="delivery_wizard_menu"
            name="Delivery"
            action="freight_delivery_wizard_action"
            parent="reports_menu"
            sequence="1"/>

    </data>
</odoo>